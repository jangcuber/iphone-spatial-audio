+    LOG(INFO, LOG_TAG) << "AVAudioSession category=" << (okCat ? "ok" : "FAILED") << " active=" << (okAct ? "ok" : "FAILED") << " sampleRate=" << rate
+                       << " outputLatency=" << outLat * 1000 << "ms ioBuffer=" << ioBuf * 1000 << "ms\n";
+    objc_autoreleasePoolPop(pool);
+}
