+void CoreAudioPlayer::runRemoteIO()
+{
+    configureIosAudioSession();
+    outputLatencyUs_ = g_outputLatencySec * 1e6;
+    const SampleFormat& sf = pubStream_->getFormat();
+    select_ = (settings_.channel >= 0) && (settings_.channel < sf.channels()) && (sf.channels() >= 2);
+    const uint32_t outChannels = select_ ? 2 : sf.channels();
+    const UInt32 maxFrames = 8192;
+    scratch_.assign(static_cast<size_t>(maxFrames) * sf.frameSize(), 0);
+
+    AudioComponentDescription desc{kAudioUnitType_Output, kAudioUnitSubType_RemoteIO, kAudioUnitManufacturer_Apple, 0, 0};
+    AudioComponent comp = AudioComponentFindNext(nullptr, &desc);
+    AudioUnit unit = nullptr;
+    if ((comp == nullptr) || (AudioComponentInstanceNew(comp, &unit) != noErr))
+        throw std::runtime_error("RemoteIO not available");
+
+    AudioStreamBasicDescription format{};
+    format.mSampleRate = sf.rate();
+    format.mFormatID = kAudioFormatLinearPCM;
+    format.mFormatFlags = kLinearPCMFormatFlagIsSignedInteger | kAudioFormatFlagIsPacked;
+    format.mBitsPerChannel = sf.bits();
+    format.mChannelsPerFrame = outChannels;
+    format.mBytesPerFrame = outChannels * sf.sampleSize();
+    format.mFramesPerPacket = 1;
+    format.mBytesPerPacket = format.mBytesPerFrame;
+    AURenderCallbackStruct cb{rioRender, this};
+    OSStatus st = AudioUnitSetProperty(unit, kAudioUnitProperty_StreamFormat, kAudioUnitScope_Input, 0, &format, sizeof(format));
+    if (st == noErr)
+        st = AudioUnitSetProperty(unit, kAudioUnitProperty_MaximumFramesPerSlice, kAudioUnitScope_Global, 0, &maxFrames, sizeof(maxFrames));
+    if (st == noErr)
+        st = AudioUnitSetProperty(unit, kAudioUnitProperty_SetRenderCallback, kAudioUnitScope_Input, 0, &cb, sizeof(cb));
+    if (st == noErr)
+        st = AudioUnitInitialize(unit);
+    lastChunkTick = chronos::getTickCount();
+    rioIdle_ = false;
+    callbacks_ = 0;
+    if (st == noErr)
+        st = AudioOutputUnitStart(unit);
+    LOG(INFO, LOG_TAG) << "RemoteIO start=" << st << ", channels: " << outChannels << ", outputLatency: " << outputLatencyUs_ / 1000. << " ms"
+                       << (select_ ? " (source channel " + std::to_string(settings_.channel) + ", speaker " + std::to_string(settings_.speaker) + ")" : std::string()) << "\n";
+    while ((st == noErr) && active_ && !rioIdle_)
+        chronos::sleep(100);
+    if (rioIdle_)
+        LOG(NOTICE, LOG_TAG) << "No chunk received for 5000ms. Stopping RemoteIO.\n";
+    AudioOutputUnitStop(unit);
+    AudioUnitUninitialize(unit);
+    AudioComponentInstanceDispose(unit);
+    pubStream_->clearChunks();
+    if (st != noErr)
+        throw std::runtime_error("RemoteIO setup failed: " + std::to_string(st));
+}
+#endif
