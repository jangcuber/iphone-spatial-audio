+/// RemoteIO render 콜백: ts->mHostTime = 이 버퍼 첫 샘플이 출력 하드웨어로 나가는 시각, 여기에 outputLatency(스피커까지)를 더한다.
+/// AudioQueue는 큐 시간축과 실제 출력 사이 시작 위상이 큐를 열 때마다 달라 재연결마다 폰별로 수~15 ms 고정 어긋남이 생겼다(2026-10-09).
+OSStatus CoreAudioPlayer::renderCallback(const AudioTimeStamp* ts, UInt32 frames, AudioBufferList* io)
+{
+    static mach_timebase_info_data_t tb{0, 0};
+    if (tb.denom == 0)
+        mach_timebase_info(&tb);
+    const SampleFormat& sf = pubStream_->getFormat();
+    char* out = static_cast<char*>(io->mBuffers[0].mData);
+    const size_t outFrameSize = (select_ ? 2 : sf.channels()) * sf.sampleSize();
+    if ((frames * sf.frameSize() > scratch_.size()) || (io->mBuffers[0].mDataByteSize < frames * outFrameSize))
+    {
+        std::memset(out, 0, io->mBuffers[0].mDataByteSize);
+        return noErr;
+    }
+    int64_t aheadUs = 0;
+    if ((ts->mFlags & kAudioTimeStampHostTimeValid) != 0)
+    {
+        const int64_t dt = static_cast<int64_t>(ts->mHostTime) - static_cast<int64_t>(mach_absolute_time());
+        aheadUs = dt * static_cast<int64_t>(tb.numer) / static_cast<int64_t>(tb.denom) / 1000;
+    }
+    chronos::usec delay(aheadUs + static_cast<int64_t>(outputLatencyUs_));
+    if (++callbacks_ % 50 == 0)
+        LOG(DEBUG, "Dac") << aheadUs << "\t" << frames << "\t" << delay.count() << "\t" << settings_.dac_mode << "\t" << outputLatencyUs_ << "\t"
+                          << ts->mFlags << "\n";
+    char* buffer = select_ ? scratch_.data() : out;
+    if (!pubStream_->getPlayerChunkOrSilence(buffer, delay, frames))
+    {
+        if (chronos::getTickCount() - lastChunkTick > 5000)
+            rioIdle_ = true;
+    }
+    else
+    {
+        lastChunkTick = chronos::getTickCount();
+        adjustVolume(buffer, frames);
+    }
+    if (select_)
+        selectChannel(buffer, out, frames);
+    return noErr;
+}
