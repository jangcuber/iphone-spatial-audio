+#ifdef IOS
+static OSStatus rioRender(void* ref, AudioUnitRenderActionFlags* flags, const AudioTimeStamp* ts, UInt32 bus, UInt32 frames, AudioBufferList* io)
+{
+    (void)flags;
+    (void)bus;
+    return static_cast<CoreAudioPlayer*>(ref)->renderCallback(ts, frames, io);
+}
