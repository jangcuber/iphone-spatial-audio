+void CoreAudioPlayer::selectChannel(const char* src, char* dst, size_t frames)
+{
+    const SampleFormat& sf = pubStream_->getFormat();
+    const size_t ss = sf.sampleSize();
+    const size_t fs = sf.frameSize();
+    const size_t off = static_cast<size_t>(settings_.channel) * ss;
+    for (size_t f = 0; f < frames; ++f)
+    {
+        const char* in = src + f * fs + off;
+        char* out = dst + f * 2 * ss;
+        // 아이폰 위/아래 스피커는 지연이 약 7 ms 달라 둘 다 내면 같은 소리가 두 번 들린다 (2026-10-08 녹음) → --speaker로 하나만
+        if (settings_.speaker == 2)
+            std::memset(out, 0, ss);
+        else
+            std::memcpy(out, in, ss);
+        if (settings_.speaker == 1)
+            std::memset(out + ss, 0, ss);
+        else
+            std::memcpy(out + ss, in, ss);
+    }
+}
